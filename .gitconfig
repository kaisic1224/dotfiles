[init]
	defaultBranch = main
[user]
	email = hiddenshadows1224@gmail.com
	name = kaisic1224
[credential]
	credentialStore = plaintext
	helper = cache --timeout 21600
	helper = oauth
[credential "https://dev.azure.com"]
	useHttpPath = true
[core]
	editor = nvim
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[gcm]
	credentialHelper = cach
	guiPrompt = false
	provider = gcm
